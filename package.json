{
  "name": "dsh-gate-game",
  "version": "0.1.0",
  "description": "Logo-eating mini-game + one-click lock button for the DeepSeek Harness web UI. A standard Cordis client plugin.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "game",
    "ui"
  ]
}
